# ============================================================
# RepoPilot Environment
# ============================================================

# Application
APP_NAME=RepoPilot
APP_ENV=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=repopilot
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://repopilot:change_me@localhost:5433/repopilot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_TOKEN=

# AI
MODEL_PROVIDER=ollama
MODEL_NAME=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# Sandbox
SANDBOX_ENABLED=true
SANDBOX_IMAGE=repopilot-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1

# Security
SECRET_KEY=change_me
JWT_SECRET_KEY=change_me

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=repopilot-api
